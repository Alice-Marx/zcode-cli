{
  "name": "zcode-cli-standalone",
  "version": "3.17.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:zcode": "node scripts/build-zcode.mjs",
    "build": "pnpm build:zcode",
    "dev": "pnpm --filter @zcode/cli dev",
    "dev:web": "concurrently -k -n server,web -c blue,green \"pnpm --filter @zcode/server dev\" \"pnpm --filter @zcode/web dev\"",
    "dev:server": "pnpm --filter @zcode/server dev",
    "build:cli": "pnpm --filter @zcode/cli... build",
    "typecheck": "tsc -b packages/shared/tsconfig.testing.json packages/rpc packages/provider packages/provider-node packages/shared packages/services packages/client packages/server packages/ui packages/web && tsc -p packages/zcode-cua --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "node --test scripts/zcode-distribution.test.mjs scripts/standalone.test.mjs scripts/installer-layout.test.mjs",
    "test:distribution": "node --test scripts/zcode-distribution.test.mjs scripts/standalone.test.mjs scripts/installer-layout.test.mjs",
    "smoke:distribution": "node scripts/zcode-distribution-smoke.mjs",
    "architecture:check": "node scripts/architecture/architecture-check.mjs check",
    "architecture:context": "node scripts/architecture/architecture-check.mjs context",
    "build:npm": "node scripts/build-npm.mjs",
    "smoke:npm": "node scripts/zcode-npm-smoke.mjs"
  },
  "dependencies": {
    "border-beam": "^1.0.1",
    "d3-path": "^3.1.0",
    "tailwind-scrollbar-hide": "^4.0.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/node": "^25.5.0",
    "@zcode/zcode-cua": "workspace:*",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "istanbul-lib-instrument": "6.0.3",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.57.0",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.19.4",
    "turbo": "^2.4.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.13.23"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "electron-to-chromium": "1.5.452"
    },
    "patchedDependencies": {
      "@radix-ui/react-collapsible@1.1.12": "patches/@radix-ui__react-collapsible@1.1.12.patch",
      "vitest@4.1.7": "patches/vitest@4.1.7.patch",
      "@ai-sdk/openai-compatible@2.0.60": "patches/@ai-sdk__openai-compatible@2.0.60.patch",
      "@ai-sdk/anthropic@3.0.81": "patches/@ai-sdk__anthropic@3.0.81.patch",
      "@aiden0z/pptx-renderer@1.2.4": "patches/@aiden0z__pptx-renderer@1.2.4.patch",
      "@extend-ai/react-xlsx@0.16.0": "patches/@extend-ai__react-xlsx@0.16.0.patch"
    }
  },
  "license": "Apache-2.0",
  "description": "Standalone ZCode TUI, local Web and Agent distribution extracted from zai-org/ZCode",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alice-Marx/zcode-cli.git"
  },
  "homepage": "https://github.com/zai-org/ZCode",
  "bugs": {
    "url": "https://github.com/Alice-Marx/zcode-cli/issues"
  }
}
